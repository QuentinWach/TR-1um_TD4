.pnr_stage/

# チップ ngspice の波形生データ（2.5MB。check_chip_sim.py が PNG にする）
layout/chip/simulation/*.raw.csv

# ngspice の生成物（scripts/gen_chip_tb.py / gen_chip_sim_ready.py が作る）
